#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
workspace_dir="$(cd -- "${script_dir}/.." && pwd -P)"

cargo_bin="${CODEX_RS_CARGO_BIN:-cargo}"

hash_workspace_path() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s' "${workspace_dir}" | shasum -a 256 | awk '{print substr($1, 1, 16)}'
    elif command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "${workspace_dir}" | sha256sum | awk '{print substr($1, 1, 16)}'
    else
        # Last-resort fallback for minimal environments. The target-dir suffix only
        # needs to be stable enough to avoid collisions between local workspaces.
        printf '%s' "${workspace_dir}" | cksum | awk '{print $1}'
    fi
}

workspace_key() {
    printf '%s-%s\n' "$(basename "${workspace_dir}")" "$(hash_workspace_path)"
}

first_marker_build_root() {
    local marker

    for marker in /Volumes/*/.codex-rs-build-root; do
        [ -d "${marker}" ] || continue
        [ -w "${marker}" ] || continue
        printf '%s\n' "${marker}"
        return 0
    done

    return 1
}

resolve_build_root() {
    local root="${1}"

    mkdir -p "${root}"
    cd -- "${root}" && pwd -P
}

select_target_dir() {
    local build_root=""

    if [ -n "${CARGO_TARGET_DIR:-}" ]; then
        printf '%s\n' "${CARGO_TARGET_DIR}"
        return 0
    fi

    if [ -n "${CODEX_RS_BUILD_ROOT:-}" ]; then
        build_root="$(resolve_build_root "${CODEX_RS_BUILD_ROOT}")"
    elif build_root="$(first_marker_build_root)"; then
        build_root="$(resolve_build_root "${build_root}")"
    else
        printf '%s\n' "${workspace_dir}/target"
        return 0
    fi

    printf '%s/target/%s\n' "${build_root}" "$(workspace_key)"
}

has_arg() {
    local needle="${1}"
    shift

    local arg
    for arg in "$@"; do
        [ "${arg}" = "${needle}" ] && return 0
    done
    return 1
}

has_help_arg() {
    local arg
    for arg in "$@"; do
        case "${arg}" in
            -h|--help)
                return 0
                ;;
        esac
    done
    return 1
}

has_cargo_quiet_arg() {
    local arg
    for arg in "$@"; do
        case "${arg}" in
            -q|--quiet)
                return 0
                ;;
        esac
    done
    return 1
}

has_harness_quiet_arg() {
    local arg
    for arg in "$@"; do
        case "${arg}" in
            -q|--quiet)
                return 0
                ;;
        esac
    done
    return 1
}

has_cargo_verbose_arg() {
    local arg
    for arg in "$@"; do
        case "${arg}" in
            -v|-vv|--verbose)
                return 0
                ;;
        esac
    done
    return 1
}

has_message_format_arg() {
    local arg prev=""
    for arg in "$@"; do
        if [ "${prev}" = "--message-format" ]; then
            return 0
        fi
        case "${arg}" in
            --message-format|--message-format=*)
                return 0
                ;;
        esac
        prev="${arg}"
    done
    return 1
}

has_harness_format_arg() {
    local arg prev=""
    for arg in "$@"; do
        if [ "${prev}" = "--format" ]; then
            return 0
        fi
        case "${arg}" in
            -q|--quiet|--format|--format=*|--list|--no-capture|--nocapture|--show-output)
                return 0
                ;;
        esac
        prev="${arg}"
    done
    return 1
}

has_harness_passthrough_output_arg() {
    local arg prev=""
    for arg in "$@"; do
        if [ "${prev}" = "--format" ]; then
            return 0
        fi
        case "${arg}" in
            --format|--format=*|--list|--no-capture|--nocapture|--show-output)
                return 0
                ;;
        esac
        prev="${arg}"
    done
    return 1
}

load_network_sandbox_test_skips() {
    local skips_file="${script_dir}/cargo-local-network-sandbox-skips.txt"
    local line

    [ -f "${skips_file}" ] || return 0

    while IFS= read -r line || [ -n "${line}" ]; do
        case "${line}" in
            ''|\#*)
                continue
                ;;
        esac
        harness_args+=(--skip "${line}")
    done <"${skips_file}"
}

arg_takes_value_before_command() {
    case "${1}" in
        --color|--config|-C|-Z|--manifest-path|--target-dir|--target|--profile|--jobs|-j|--package|-p|--exclude|--bin|--example|--test|--bench|--features|-F)
            return 0
            ;;
    esac
    return 1
}

find_subcommand_index() {
    local i=0 arg

    while [ "${i}" -lt "${#argv[@]}" ]; do
        arg="${argv[${i}]}"
        case "${arg}" in
            --|-h|--help|-V|--version)
                return 1
                ;;
            +*)
                i=$((i + 1))
                ;;
            --*=*)
                i=$((i + 1))
                ;;
            --*)
                if arg_takes_value_before_command "${arg}"; then
                    i=$((i + 2))
                else
                    i=$((i + 1))
                fi
                ;;
            -*)
                if arg_takes_value_before_command "${arg}"; then
                    i=$((i + 2))
                else
                    i=$((i + 1))
                fi
                ;;
            *)
                printf '%s\n' "${i}"
                return 0
                ;;
        esac
    done

    return 1
}

rewrite_cargo_test_args() {
    local subcommand_index="${1}"
    local output_mode="${CODEX_RS_CARGO_LOCAL_TEST_OUTPUT:-agent}"

    case "${output_mode}" in
        agent|quiet|token-efficient|minimal)
            ;;
        raw|passthrough|off|0|false)
            return 0
            ;;
        *)
            printf 'cargo-local: unsupported CODEX_RS_CARGO_LOCAL_TEST_OUTPUT=%s; expected agent or raw\n' "${output_mode}" >&2
            return 2
            ;;
    esac

    local prefix=()
    local cargo_args=()
    local harness_args=()
    local rewritten=()
    local saw_separator=0
    local cargo_quiet=0
    local harness_quiet=0
    local explicit_message_format=0
    local passthrough_harness_output=0
    local filtered_harness_args=()
    local i arg

    i=0
    while [ "${i}" -le "${subcommand_index}" ]; do
        prefix+=("${argv[${i}]}")
        i=$((i + 1))
    done

    while [ "${i}" -lt "${#argv[@]}" ]; do
        arg="${argv[${i}]}"
        if [ "${saw_separator}" -eq 0 ] && [ "${arg}" = "--" ]; then
            saw_separator=1
        elif [ "${saw_separator}" -eq 0 ]; then
            cargo_args+=("${arg}")
        else
            harness_args+=("${arg}")
        fi
        i=$((i + 1))
    done

    # Preserve help/list semantics exactly. --no-run has no libtest execution
    # phase, so it only gets Cargo-level output defaults.
    if has_help_arg "${cargo_args[@]}" || has_help_arg "${harness_args[@]}" || has_arg --list "${harness_args[@]}"; then
        return 0
    fi

    if has_harness_passthrough_output_arg "${harness_args[@]}"; then
        passthrough_harness_output=1
    fi
    if has_message_format_arg "${prefix[@]}" "${cargo_args[@]}"; then
        explicit_message_format=1
    fi

    rewritten=("${prefix[@]}")

    if has_harness_quiet_arg "${harness_args[@]}"; then
        harness_quiet=1
    fi

    if has_cargo_quiet_arg "${prefix[@]}" "${cargo_args[@]}"; then
        cargo_quiet=1
    elif ! has_cargo_verbose_arg "${prefix[@]}" "${cargo_args[@]}"; then
        rewritten+=(--quiet)
        cargo_quiet=1
    fi

    if [ "${explicit_message_format}" -eq 0 ]; then
        rewritten+=(--message-format=short)
    fi

    rewritten+=("${cargo_args[@]}")

    if has_arg --no-run "${cargo_args[@]}"; then
        argv=("${rewritten[@]}")
        return 0
    fi

    if should_wrap_network_disabled; then
        load_network_sandbox_test_skips
        saw_separator=1
    fi

    if [ "${passthrough_harness_output}" -eq 0 ] && [ "${explicit_message_format}" -eq 0 ]; then
        cargo_local_filter_test_output=1
    fi

    # Cargo forwards its quiet mode to libtest. Passing an additional
    # `-- --quiet` makes the harness reject the duplicated option.
    if [ "${cargo_quiet}" -eq 1 ] && [ "${harness_quiet}" -eq 1 ]; then
        filtered_harness_args=()
        for arg in "${harness_args[@]}"; do
            case "${arg}" in
                -q|--quiet)
                    ;;
                *)
                    filtered_harness_args+=("${arg}")
                    ;;
            esac
        done
        harness_args=("${filtered_harness_args[@]}")
    elif [ "${cargo_quiet}" -eq 0 ] && ! has_harness_format_arg "${harness_args[@]}"; then
        harness_args=(--quiet "${harness_args[@]}")
        saw_separator=1
    fi

    if [ "${saw_separator}" -eq 1 ]; then
        rewritten+=(-- "${harness_args[@]}")
    fi

    argv=("${rewritten[@]}")
}

filter_cargo_test_output() {
    local cargo_status="${1}"

    awk \
        -f "${script_dir}/cargo-local-test-filter.awk" \
        -v cargo_status="${cargo_status}" \
        -v home_dir="${HOME:-}" \
        -v tmp_dir="${tmp_dir}" \
        -v tmp_dir_real="${tmp_dir_real}" \
        -v target_dir="${target_dir}" \
        -v workspace_dir="${workspace_dir}"
}

network_disabled_policy() {
    printf '%s\n' \
        '(version 1)' \
        '(allow default)' \
        '(deny network-outbound (remote ip "*:*"))' \
        '(deny network-bind (local ip "*:*"))' \
        '(deny network-inbound (local ip "*:*"))' \
        '(allow network-outbound (remote ip "localhost:*"))' \
        '(allow network-bind (local ip "localhost:*"))' \
        '(allow network-inbound (local ip "localhost:*"))'
}

should_wrap_network_disabled() {
    [ -n "${CODEX_SANDBOX_NETWORK_DISABLED:-}" ] || return 1
    [ "$(uname -s)" = "Darwin" ] || return 1
    [ "${CODEX_SANDBOX:-}" != "seatbelt" ] || return 1
    [ -x /usr/bin/sandbox-exec ] || return 1
    return 0
}

run_cargo_command() {
    if should_wrap_network_disabled; then
        /usr/bin/sandbox-exec -p "$(network_disabled_policy)" \
            /usr/bin/env \
            -u ALL_PROXY \
            -u HTTPS_PROXY \
            -u HTTP_PROXY \
            -u NO_PROXY \
            -u all_proxy \
            -u https_proxy \
            -u http_proxy \
            -u no_proxy \
            CODEX_SANDBOX=seatbelt \
            "${cargo_bin}" "$@"
    else
        "${cargo_bin}" "$@"
    fi
}

run_filtered_cargo_test() {
    local output_file
    local filter_status
    local status

    output_file="$(mktemp "${TMPDIR:-/tmp}/cargo-local.XXXXXX")"
    trap 'rm -f "${output_file}"' RETURN

    set +e
    run_cargo_command "${argv[@]}" >"${output_file}" 2>&1
    status="${?}"
    set -e

    filter_status=0
    filter_cargo_test_output "${status}" <"${output_file}" || filter_status="${?}"
    rm -f "${output_file}"
    trap - RETURN

    if [ "${filter_status}" -ne 0 ]; then
        return "${filter_status}"
    fi

    return "${status}"
}

cargo_local_filter_test_output=0

target_dir="$(select_target_dir)"
tmp_dir="${TMPDIR:-/tmp}"
tmp_dir="${tmp_dir%/}"
[ -n "${tmp_dir}" ] || tmp_dir="/"
tmp_dir_real="$(cd -- "${tmp_dir}" && pwd -P)"

if [ "${1:-}" = "--print-target-dir" ]; then
    printf '%s\n' "${target_dir}"
    exit 0
fi

if [ -z "${CARGO_TARGET_DIR:-}" ] && [ "${target_dir}" != "${workspace_dir}/target" ]; then
    mkdir -p "${target_dir}"
    export CARGO_TARGET_DIR="${target_dir}"
fi

if [ "${CODEX_RS_CARGO_LOCAL_VERBOSE:-}" = "1" ]; then
    printf 'cargo-local: CARGO_TARGET_DIR=%s\n' "${target_dir}" >&2
fi

argv=("$@")
if subcommand_index="$(find_subcommand_index)" && [ "${argv[${subcommand_index}]}" = "test" ]; then
    rewrite_cargo_test_args "${subcommand_index}"
fi

if [ "${cargo_local_filter_test_output}" -eq 1 ]; then
    if run_filtered_cargo_test; then
        exit 0
    else
        status="${?}"
        exit "${status}"
    fi
fi

if should_wrap_network_disabled; then
    exec /usr/bin/sandbox-exec -p "$(network_disabled_policy)" \
        /usr/bin/env \
        -u ALL_PROXY \
        -u HTTPS_PROXY \
        -u HTTP_PROXY \
        -u NO_PROXY \
        -u all_proxy \
        -u https_proxy \
        -u http_proxy \
        -u no_proxy \
        CODEX_SANDBOX=seatbelt \
        "${cargo_bin}" "${argv[@]}"
fi

exec "${cargo_bin}" "${argv[@]}"
