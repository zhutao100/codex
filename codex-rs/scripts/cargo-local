#!/usr/bin/env bash
set -euo pipefail

wrapper="${CARGO_LOCAL_BIN:-${HOME}/.local/share/codex-rust-wrappers/cargo-local}"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
workspace_dir="$(cd -- "${script_dir}/.." && pwd -P)"

if [ ! -x "${wrapper}" ]; then
    printf 'scripts/cargo-local: shared cargo-local wrapper is not executable: %s\n' "${wrapper}" >&2
    exit 127
fi

export CARGO_LOCAL_WORKSPACE_DIR="${CARGO_LOCAL_WORKSPACE_DIR:-${workspace_dir}}"
exec "${wrapper}" "$@"
